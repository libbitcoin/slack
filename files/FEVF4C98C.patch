+### Fetch transaction:
+```js
+const zmq = require('zeromq');
+const pystruct = require('python-struct');
+const requester = zmq.socket('req');
+
+const endpoint = 'tcp://mainnet.libbitcoin.net:9091';
+
+requester.on('message', function(command, identifier, buffer) {
+  console.log(buffer.toString('hex').substr(8));
+  requester.close();
+});
+
+requester.setsockopt(zmq.ZMQ_RCVTIMEO, 5000);
+requester.setsockopt(zmq.ZMQ_SNDTIMEO, 5000);
+requester.connect(endpoint);
+
+const txhash = '60e030aba2f593caf913a7d96880ff227143bfc370d03dbaee37d582801ebd83';
+requester.send('blockchain.fetch_transaction2', zmq.ZMQ_SNDMORE);
+requester.send(pystruct.pack('I', 42), zmq.ZMQ_SNDMORE);
+requester.send(Buffer.from(txhash.match(/.{1,2}/g).reverse().join(''), 'hex'));
+
+```
+Output:
+```

+```
+
+### Fetch block header
+```js
+const zmq = require('zeromq');
+const pystruct = require('python-struct');
+const requester = zmq.socket('req');
+
+const endpoint = 'tcp://mainnet.libbitcoin.net:9091';
+
+requester.on('message', function(command, identifier, buffer) {
+  console.log({
+    'command': command.toString(),
+    'identifier': identifier.readUInt32LE(),
+    'code': buffer.readUInt32LE(0),
+    'version': buffer.readInt32LE(4),
+    'prev_block': buffer.slice(8, 40).toString('hex').match(/.{1,2}/g).reverse().join(''),
+    'merkle_root': buffer.slice(40, 72).toString('hex').match(/.{1,2}/g).reverse().join(''),
+    'timestamp': buffer.readUInt32LE(72),
+    'bits': buffer.readUInt32LE(76),
+    'nonce': buffer.readUInt32LE(80)
+  });
+
+  requester.close();
+});
+
+requester.setsockopt(zmq.ZMQ_SNDTIMEO, 5000);
+requester.setsockopt(zmq.ZMQ_RCVTIMEO, 5000);
+requester.connect(endpoint);
+
+requester.send('blockchain.fetch_block_header', zmq.ZMQ_SNDMORE);
+requester.send(pystruct.pack('I', 42), zmq.ZMQ_SNDMORE);
+requester.send(pystruct.pack('I', 123456));
+
+```
+Output:
+```js
+{
+  command: 'blockchain.fetch_block_header',
+  identifier: 42,
+  code: 0,
+  version: 1,
+  prev_block: '0000000000000b60bc96a44724fd72daf9b92cf8ad00510b5224c6253ac40095',
+  merkle_root: '0e60651a9934e8f0decd1c5fde39309e48fca0cd1c84a21ddfde95033762d86c',
+  timestamp: 1305200806,
+  bits: 443192243,
+  nonce: 2436437219
+}
+```
