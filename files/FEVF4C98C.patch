@@ -0,0 +1,26 @@
+Libbitcoin server currently allows subscriptions for service Heartbeats, Blocks, and Transactions.  An example Javascript listener client is shown below, with sample output.
+
+### Heartbeat Subscription
+```js
+const zmq = require('zeromq');
+const subscriber = zmq.socket('sub');
+
+const endpoint = 'tcp://mainnet.libbitcoin.net:9092';
+
+subscriber.on('message', function(sequence, buffer) {
+  console.log({
+    'sequence': sequence.readUInt16LE(0),
+    'height': buffer.readUInt32LE(0)
+  });
+});
+
+subscriber.setsockopt(zmq.ZMQ_TCP_KEEPALIVE, 1);
+subscriber.setsockopt(zmq.ZMQ_SUBSCRIBE, Buffer.alloc(0));
+subscriber.connect(endpoint);
+
+```
+Output:
+```
+{ sequence: 61577, height: 1447978 }
+{ sequence: 61578, height: 1447978 }
+```
